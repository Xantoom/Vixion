		"react-dom": "^19.3.1",
		"xantoom-design": "github:Xantoom/xantoom-design#v0.4.2",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"oxfmt": "^0.80.0",
